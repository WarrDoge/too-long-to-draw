{
  "name": "too-long-to-draw",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "setup": "bun install && bun scripts/setup.ts",
    "dev": "bun --hot src/server/main.ts",
    "start": "NODE_ENV=production bun src/server/main.ts",
    "test": "bun test src",
    "e2e": "bun test e2e",
    "check": "biome ci && tsc --noEmit && tsc --noEmit -p src/core && tsc --noEmit -p src/web && bun run test",
    "bump": "bun upgrade && bun scripts/bump.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2"
  }
}
